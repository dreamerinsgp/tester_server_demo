// GHA + Jenkins 模式：GitHub Actions 构建推送镜像，Webhook 触发 Jenkins 部署 + 冒烟测试
// 支持：① Webhook 传入 DOCKER_TAG（跳过构建）  ② 手动触发时可选传入 DOCKER_TAG 或完整构建

def TEST_REPO_URL = 'https://github.com/dreamerinsgp/api_auto_framework.git'
def TEST_REPO_BRANCH = 'main'

pipeline {
    agent any

    parameters {
        string(name: 'DOCKER_TAG', defaultValue: '', description: 'GHA Webhook 传入的镜像 tag，留空则执行完整 Build & Push')
    }

    environment {
        PATH = "/usr/bin:/usr/local/bin:${env.PATH}"
        KUBECONFIG = "${env.HOME}/.jenkins/kubeconfig"
        STAGING_URL = 'http://8.217.228.180:30080'
    }

    stages {
        stage('Checkout Project') {
            steps {
                checkout scm
            }
        }

        stage('Checkout Test Framework') {
            steps {
                dir('api_auto') {
                    checkout([
                        $class: 'GitSCM',
                        branches: [[name: "*/${TEST_REPO_BRANCH}"]],
                        userRemoteConfigs: [[url: TEST_REPO_URL]]
                    ])
                }
            }
        }

        stage('Build & Push') {
            when {
                expression { return params.DOCKER_TAG?.trim() == '' }
            }
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'docker-hub',
                    usernameVariable: 'DOCKER_USERNAME',
                    passwordVariable: 'DOCKER_PASSWORD'
                )]) {
                    sh '''
                        docker login -u $DOCKER_USERNAME -p $DOCKER_PASSWORD
                        docker build -f demo_server/Dockerfile -t $DOCKER_USERNAME/demo-server:${BUILD_NUMBER} .
                        docker push $DOCKER_USERNAME/demo-server:${BUILD_NUMBER}
                        echo "DOCKER_IMAGE=$DOCKER_USERNAME/demo-server:${BUILD_NUMBER}" > env.txt
                    '''
                }
            }
        }

        stage('Prepare Image') {
            when {
                expression { return params.DOCKER_TAG?.trim() != '' }
            }
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'docker-hub',
                    usernameVariable: 'DOCKER_USERNAME',
                    passwordVariable: 'DOCKER_PASSWORD'
                )]) {
                    sh "echo 'DOCKER_IMAGE='\${DOCKER_USERNAME}'/demo-server:${params.DOCKER_TAG}' > env.txt"
                }
            }
        }

        stage('Deploy to K8s') {
            steps {
                script {
                    def image = readFile('env.txt').trim().split('=')[1]
                    sh """
                        KUBECTL=\$(command -v kubectl 2>/dev/null)
                        [ -z "\$KUBECTL" ] && KUBECTL="/usr/bin/kubectl"
                        [ ! -x "\$KUBECTL" ] && echo "kubectl not found" && exit 1
                        \$KUBECTL apply -f k8s/namespace.yaml
                        sed -e 's|PLACEHOLDER_IMAGE|${image}|' k8s/demo-server-deployment.yaml | \$KUBECTL apply -f -
                        \$KUBECTL apply -f k8s/demo-server-service.yaml
                        \$KUBECTL rollout status deployment/demo-server -n staging --timeout=120s
                    """
                }
            }
        }

        stage('Smoke Test') {
            steps {
                sh """
                    pip install --break-system-packages -q -r api_auto/requirements.txt
                    cd api_auto && BASE_URL=${env.STAGING_URL} pytest -m smoke -v --tb=short
                """
            }
        }
    }
}
